#!/bin/bash
set -euo pipefail

# Pre-commit hook for aws-cw-tui
# Runs the same checks as CI to catch issues before committing

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

print_status() {
    echo -e "${GREEN}✓${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}⚠${NC} $1"
}

print_error() {
    echo -e "${RED}✗${NC} $1"
}

print_header() {
    echo -e "${BLUE}==>${NC} $1"
}

cd "$PROJECT_ROOT"

echo ""
echo "Running pre-commit checks..."
echo ""

# Check if Cargo.toml exists
if [ ! -f "Cargo.toml" ]; then
    print_error "Cargo.toml not found. Are you in the right directory?"
    exit 1
fi

# Track overall success
FAILED=0

# 1. Check formatting
print_header "Checking code formatting (cargo fmt)"
if cargo fmt --all -- --check 2>/dev/null; then
    print_status "Code formatting OK"
else
    print_error "Code formatting issues found. Run 'cargo fmt' to fix."
    FAILED=1
fi

# 2. Run clippy
print_header "Running linter (cargo clippy)"
if cargo clippy --all-targets --all-features -- -D warnings -A dead_code 2>/dev/null; then
    print_status "Clippy checks passed"
else
    print_error "Clippy found issues. Please fix the warnings above."
    FAILED=1
fi

# 3. Run tests
print_header "Running tests (cargo test)"
if cargo test --quiet 2>/dev/null; then
    print_status "All tests passed"
else
    print_error "Some tests failed. Please fix them before committing."
    FAILED=1
fi

# 4. Check if it builds
print_header "Checking build (cargo build)"
if cargo build --quiet 2>/dev/null; then
    print_status "Build successful"
else
    print_error "Build failed. Please fix compilation errors."
    FAILED=1
fi

# 5. Check Markdown files
print_header "Checking Markdown files"
MD_FILES=$(find . -name "*.md" -not -path "./.git/*" -not -path "./target/*" 2>/dev/null)

if [ -n "$MD_FILES" ]; then
    MD_ISSUES=0

    # Check if markdownlint-cli is available
    if command -v markdownlint &> /dev/null; then
        if ! markdownlint $MD_FILES 2>/dev/null; then
            MD_ISSUES=1
        fi
    else
        # Fallback: basic checks for common issues
        for file in $MD_FILES; do
            # Check for trailing whitespace (except in code blocks)
            if grep -n '[[:space:]]$' "$file" > /dev/null 2>&1; then
                echo "  Trailing whitespace in: $file"
                MD_ISSUES=1
            fi

            # Check for missing final newline
            if [ -n "$(tail -c 1 "$file")" ]; then
                echo "  Missing final newline in: $file"
                MD_ISSUES=1
            fi

            # Check for multiple consecutive blank lines
            if awk '/^$/{blank++; if(blank>1){exit 1}} /^./{blank=0}' "$file"; then
                :
            else
                echo "  Multiple consecutive blank lines in: $file"
                MD_ISSUES=1
            fi
        done
    fi

    if [ $MD_ISSUES -eq 0 ]; then
        print_status "Markdown files OK"
    else
        print_warning "Markdown issues found (non-blocking). Consider installing markdownlint-cli for detailed checks."
    fi
else
    print_status "No Markdown files to check"
fi

echo ""

if [ $FAILED -ne 0 ]; then
    print_error "Pre-commit checks failed. Please fix the issues above."
    echo ""
    echo "To bypass this hook (not recommended), use: git commit --no-verify"
    exit 1
fi

print_status "All pre-commit checks passed!"
echo ""
